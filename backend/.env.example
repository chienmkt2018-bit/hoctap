# Copy to .env for local development. Never commit real credentials.
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Add the MongoDB Atlas connection string only to local .env or Render Environment.
# Example format: mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=
# Generate a cryptographically random secret of at least 32 bytes.
# Example: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Set this only in local .env or Render Environment. Never commit the real value.
JWT_SECRET=
