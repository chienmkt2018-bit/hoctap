# Copy to .env for local development. Never commit real credentials.
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Add the MongoDB Atlas connection string only to local .env or Render Environment.
# Example format: mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=
# P3.3: add JWT_SECRET through local .env / Render Environment, not source control.
